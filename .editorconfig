root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,ts,html,scss,css,js,mjs,yml,yaml,xml,csproj,esproj,slnx,props}]
indent_size = 2

[*.cmd]
end_of_line = crlf

# EF Core migrations are generated code: analyzers must not rewrite them.
[src/AzureEntraStarter.Infrastructure/Data/Migrations/*.cs]
generated_code = true
