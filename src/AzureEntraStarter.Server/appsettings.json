{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "Provider": "SqlServer",
    "MigrateOnStartup": false
  },
  "DataProtection": {
    "KeyVaultKeyId": ""
  },
  "Authentication": {
    "Entra": {
      "Enabled": false,
      "Authority": "https://login.microsoftonline.com/<directory-id>/v2.0",
      "MetadataAddress": "",
      "ClientId": "",
      "ClientCredentialType": "ClientSecret",
      "ClientSecret": "",
      "ClientCertificate": "",
      "ClientCertificatePassword": "",
      "ManagedIdentityClientId": "",
      "ManagedIdentityAudience": "api://AzureADTokenExchange",
      "CallbackPath": "/api/auth/oidc/callback",
      "AllowedTenantIds": [],
      "AllowPersonalAccounts": false,
      "AutoProvisionUsers": true,
      "SignOutOfMicrosoft": false
    }
  },
  "Jwt": {
    "Issuer": "AzureEntraStarter",
    "Audience": "AzureEntraStarter.Api",
    "SigningKey": "",
    "PreviousPublicKeys": [],
    "AccessTokenMinutes": 10
  },
  "Session": {
    "RefreshTokenMinutes": 60,
    "MaxSessionHours": 12,
    "ReuseGraceSeconds": 30,
    "SignInTicketSeconds": 120
  },
  "RateLimits": {
    "AuthPerMinute": 20,
    "SessionPerMinute": 60
  }
}
